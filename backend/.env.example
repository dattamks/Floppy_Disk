# Copy to .env for local dev. In prod these come from the platform (Railway/AWS).

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database / Redis (docker-compose defaults) ---
DATABASE_URL=postgres://floppy:floppy@localhost:5432/floppy
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- CORS (frontend dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Cloudflare R2 (S3-compatible) ---
# If these are left blank the app auto-falls back to a local media folder
# (DEV_STORAGE_DIR) for storage and direct (non-Stream) video delivery.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
# region -> bucket map for data residency (per-region dedup), JSON:
R2_REGION_BUCKETS={"ap-south":"floppy-ap-south","us-east":"floppy-us-east"}

# --- Cloudflare Stream ---
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# --- Razorpay ---
# Master switch. When false, billing is deferred and new users default to
# DEFAULT_SIGNUP_PLAN (paid). Set true to enable real Razorpay checkout.
RAZORPAY_ENABLED=false
DEFAULT_SIGNUP_PLAN=paid_2tb
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- ClamAV ---
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Sentry (optional) ---
SENTRY_DSN=

# --- Email (verification + password-reset links) ---
DEFAULT_FROM_EMAIL=Floppy Disk <no-reply@floppy.disk>
FRONTEND_BASE_URL=http://localhost:5173

# --- Malware scanner downtime policy: "closed" (safe, block) or "open" ---
SCAN_FAILURE_MODE=closed

# --- Legal / compliance ---
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=grievance@floppy.disk
GRIEVANCE_OFFICER_ADDRESS=
TOS_VERSION=2026-01-01
PRIVACY_VERSION=2026-01-01
