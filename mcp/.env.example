# Floppy Disk MCP server configuration.
# Copy to .env (or export these) before running the server.

# Base URL of the Floppy Disk API, including the /api/v1 prefix.
FLOPPY_API_BASE_URL=http://localhost:8000/api/v1

# A Bearer API key. Mint one on the backend:
#   python manage.py create_api_key you@example.com --name mcp
FLOPPY_API_KEY=fd_replace_me

# Transport for `python -m floppy_mcp.server`: stdio (default), http, or sse.
# FLOPPY_MCP_TRANSPORT=stdio
